# ── Site ─────────────────────────────────────────────
# 배포 후 실제 도메인으로 바꿔주세요 (sitemap / OG 메타에 사용)
NEXT_PUBLIC_SITE_URL=https://longshorttalk.vercel.app

# ── Supabase (선택) ───────────────────────────────────
# 비워두면 앱은 자동으로 "데모 모드(브라우저 로컬 저장)"로 100% 동작합니다.
# Supabase 프로젝트 생성 → Settings > API 에서 아래 두 값을 복사하세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 시세 피드 (선택) ──────────────────────────────────
# auto(기본): 바이낸스 → OKX → 데모 순서로 자동 전환
# binance | okx | demo 로 고정할 수 있습니다.
NEXT_PUBLIC_MARKET_SOURCE=auto
